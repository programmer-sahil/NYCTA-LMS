{
  "name": "nycta-lms",
  "version": "0.1.0",
  "private": true,
  "description": "Learning Management System for National Youth Computer Training Center",
  "packageManager": "pnpm@10.13.1",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @nycta/web --filter @nycta/api dev",
    "dev:web": "pnpm --filter @nycta/web dev",
    "dev:api": "pnpm --filter @nycta/api dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "^9.31.0",
    "eslint": "^9.31.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.38.0"
  }
}
